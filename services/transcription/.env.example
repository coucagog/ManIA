# Copier en .env (chmod 600), remplir, NE JAMAIS committer le .env réel.

# Secret maître partagé — sert à dériver le token de chaque tenant :
#   token_<slug> = HMAC-SHA256(SHARED_SERVICES_SECRET, slug)
# Même patron que PROVISIONING_SECRET (STACK.md §20). Généré une fois :
#   openssl rand -hex 32
# ⚠️ Le MÊME secret doit être copié dans /opt/hermes/gabarit/.shared-services-secret
#    (0600, root) pour que nouveau-tenant.sh puisse dériver le token des tenants.
SHARED_SERVICES_SECRET=

# --- Réglages (défauts pour ce VPS pilote, peu de cœurs) --------------------
# Défaut = 1 worker x 2 threads CPU : file d'attente (STACK.md §6), un job à la
# fois mais rapide. Les agents peuvent soumettre en concurrence, les requêtes
# patientent en file. Pour un vrai parallélisme (WHISPER_WORKERS=2), il faut
# d'abord régler num_workers du modèle (thread-safety) et revérifier la RAM.
# Garder WORKERS x CPU_THREADS <= cpus du compose (2).
# WHISPER_MODEL_SIZE=small
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_WORKERS=1
# WHISPER_CPU_THREADS=2
# MAX_UPLOAD_MB=100
# REQUEST_TIMEOUT_S=300
